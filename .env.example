# Mandate live mode (`mandate run --live`) configuration.
# Copy to `.env` and source it, or export these in your shell.

# --- Hedera payer account (funds every purchase) ---------------------------
# A testnet account that holds the USDC service budget (0.0.429274) and
# ~1 HBAR for HCS receipt fees. Get one at https://portal.hedera.com/ and mint
# testnet USDC at https://faucet.circle.com/ (select Hedera Testnet). The
# account must be associated with the USDC token before it can pay.
MANDATE_ACCOUNT_ID=0.0.1234567
MANDATE_PRIVATE_KEY=0x...

# --- Sellers ---------------------------------------------------------------
# The x402 seller fleet answers 402 with requirements; the facilitator co-signs
# and submits the transfer. GRAPH_API_KEY queries the live Uniswap v3 subgraph.
GRAPH_API_KEY=...
SELLER_PORT=4021

# --- Settlement + receipts ---------------------------------------------------
# Blocky402 testnet facilitator and mirror node are the defaults; RECEIPTS_TOPIC
# is a topic you create on testnet for the HCS audit trail. Leave RECEIPTS_TOPIC
# unset to keep receipts local.
FACILITATOR_URL=https://api.testnet.blocky402.com
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1
# RECEIPTS_TOPIC=0.0.1234567

# --- Evidence provenance -----------------------------------------------------
# Ethereum JSON-RPC used to spot-check that cited Uniswap v3 transactions exist
# on chain (a public RPC or your Alchemy key).
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/...
